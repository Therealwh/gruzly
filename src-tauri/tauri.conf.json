{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gruzly",
  "version": "0.2.0",
  "identifier": "app.gruzly.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Gruzly",
        "width": 1180,
        "height": 780,
        "minWidth": 940,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "visible": false,
        "resizable": true,
        "shadow": true,
        "theme": null
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; style-src 'self' 'unsafe-inline'; frame-src https://www.youtube-nocookie.com https://www.youtube.com https://vk.com https://vkvideo.ru https://rutube.ru https://ok.ru https://dzen.ru https://player.twitch.tv https://player.bilibili.com; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/yt-dlp",
      "binaries/aria2c",
      "binaries/ffmpeg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "aria2",
          "libwebkit2gtk-4.1-0"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Therealwh/gruzly/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIyOTA2RUI0REJCNTE2RTcKUldUbkZyWGJ0RzZRSXZnWVdPaFJkMHhoM0tQSXRqcW9VaHhBUnhvWmhuWTFsMTRLOUhLbUtucXcK"
    }
  }
}